    "design": {
      "components": [
        {
          "type": "form",
          "name": "DatasourceWhitelistingDetailForm",
          "tabTitle": "Details",
          "props": {
            "blockNavigationWhenDirty": false,
            "actions": [
              {
                "title": "Save",
                "icon": "save",
                "buttonColor": "primary",
                "disabled": true,
                "action": {
                  "navigation": {
                    "submit": true
                  }
                }
              },
              {
                "title": "Delete",
                "icon": {
                  "icon": "trash",
                  "variant": "solid"
                },
                "buttonColor": "error",
                "disabled": true,
                "action": [
                  {
                    "type": "confirmation",
                    "buttonColor": "error",
                    "submitIcon": {
                      "icon": "trash",
                      "variant": "solid"
                    },
                    "message": {
                      "__transform": "\"Delete Datasource Whitelisting \" & data.id & \"?\""
                    }
                  },
                  {
                    "type": "mutation",
                    "transforms": {
                      "pre": "{\n              \"payload\": {\n                \"where\": {\n                    \"id\": data.id\n                  }\n                }\n              }"
                    },
                    "api": "Application",
                    "mutation": "mutation DeleteDatasourceWhitelisting($payload: [DatasourceWhitelistingDeletePayloadInput!]!) {\n        mutation: deleteDatasourceWhitelisting(payload: $payload) { \n          id\n          id\n      }\n    }",
                    "message": {
                      "__transform": "\"Datasource Whitelisting \" & data.mutation.id & \" deleted successfully.\""
                    }
                  },
                  {
                    "type": "navigation",
                    "back": true
                  }
                ]
              },
              {
                "title": "Copy To Node",
                "icon": {
                  "icon": "clipboard",
                  "variant": "regular"
                },
                "buttonColor": "secondary",
                "action": [
                  {
                    "type": "transformation",
                    "transformation": "(\n  $formatParameters := function($inputs){\n    $merge([$inputs.{\n      name: null\n    }])~>$jsonStringify({ \"space\": 2 })\n  };\n  \n  $formatNote := function($data) {\n    $join(\n      [\n        \"Datasource Key: \" & $data.id,\n        \"Datasource Name: \" & $data.name,\n        $count($data.columns) > 0 ?\n        [          \n          \"--------Columns--------\",\n          $data.columns.(\n            name & \": \" & type\n          )\n        ]\n      ],\n      '\\n\\n'\n    )\n  };\n\n  $writeToClipboard([\n    {\n      \"type\": \"plexDatasourceV2\",\n      \"selected\": true,\n      \"x\": 0,\n      \"y\": 0,\n      \"data\": {\n        \"parameterTransform\": $formatParameters($$.data.inputs),\n        \"responseTransform\": \"$\",\n        \"returnErrors\": false,\n        \"connectionNameTransform\": undefined,\n        \"datasourceKey\": $string()\n      },\n      \"name\": data.name,\n      \"note\": $formatNote(data)\n    }\n  ])\n)",
                    "remote": false,
                    "message": {
                      "__transform": "\"Copied node to clipboard. Replace null values with undefined or remove them if they are not being utilized\""
                    },
                    "submitIcon": {
                      "icon": "clipboard",
                      "variant": "regular"
                    },
                    "title": "Copy To Plex Datasource Node"
                  }
                ]
              }
            ],
            "sections": [
              {
                "formInputs": [
                  {
                    "name": "id",
                    "description": "The primary unique ID of the record.  Every model should have an id field.",
                    "label": "Datasource Key",
                    "type": "display",
                    "dataPath": "id",
                    "query": {
                      "fields": [
                        "id"
                      ]
                    }
                  },
                  {
                    "name": "name",
                    "description": "",
                    "label": "Name",
                    "type": "display",
                    "dataPath": "name",
                    "validation": {
                      "required": false
                    },
                    "query": {
                      "fields": [
                        "name"
                      ]
                    }
                  },
                  {
                    "name": "description",
                    "description": "",
                    "label": "Description",
                    "type": "markdown",
                    "dataPath": "description",
                    "validation": {
                      "required": false
                    },
                    "query": {
                      "fields": [
                        "description"
                      ]
                    }
                  }
                ]
              },
              {
                "title": "Fields",
                "formInputs": [
                  {
                    "name": "inputs",
                    "description": "",
                    "label": "Inputs",
                    "type": "json",
                    "dataPath": "inputs",
                    "validation": {
                      "required": false
                    },
                    "query": {
                      "fields": [
                        "inputs"
                      ]
                    }
                  },
                  {
                    "name": "outputs",
                    "description": "",
                    "disabled": true,
                    "label": "Output",
                    "type": "json",
                    "dataPath": "outputs",
                    "validation": {
                      "required": false
                    },
                    "data": {
                      "__transform": "$count([data.outputs]) > 0 ? data.outputs : data.columns"
                    }
                  }
                ]
              }
            ],
            "updateAction": {
              "api": "Application",
              "transforms": {
                "pre": "{\n            \"create\": [\n              $isNilOrEmpty(initialData.id) ? {\n                \"create\": $merge([data,{\"id\": $metadata.urlParameters.id }])\n              } : undefined\n            ],\n            \"update\": [\n             $isNilOrEmpty(initialData.id)~>$not() ? {\n                \"where\": {\n                  \"id\": initialData.id\n                },\n                \"update\": data\n              } : undefined\n            ]\n          }"
              },
              "mutation": "mutation createUpdateDatasourceWhitelisting($create: [DatasourceWhitelistingCreatePayloadInput!]!,$update: [DatasourceWhitelistingUpdatePayloadInput!]!) {\n          create: createDatasourceWhitelisting(payload: $create) {\n            id\n            id\n          }\n          update: updateDatasourceWhitelisting(payload: $update) {\n            id\n            id\n          }\n        }"
            },
            "query": {
              "dataTransform": {
                "remote": true,
                "transform": "$isNilOrEmpty($metadata.urlParameters.connectionId)?[]:\n( \n  $executeCall := function(\n    $connectionId,\n    $datasourceKey,\n    $datasourceName\n  ){\n    (\n      $output := {\n        \"result\": {\n          \"connectionId\": $connectionId,\n          \"payload\": [\n            {\n              \"method\": \"get\",\n              \"parameters\": {\n                \"datasourceKey\": $isNilOrEmpty($datasourceKey) ? undefined : $datasourceKey,\n                \"datasourceName\": $isNilOrEmpty($datasourceName) ? undefined : $datasourceName\n              }\n            }\n          ]\n        }\n      }\n      ~>$integrate;\n      \n      $output.result.Rows[0];\n    )\n  };\n  \n  $executeCall(\n    $metadata.urlParameters.connectionId,\n    $parseNumber($metadata.urlParameters.id),\n    undefined\n  );\n)"
              }
            },
            "parameters": [
              {
                "dataPath": "id",
                "type": "parameter",
                "parameterName": "id"
              }
            ]
          }
        }
      ]
    }
  },
